{
  "name": "fusim-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "lint": "oxlint",
    "test": "node --test vite-plugins/*.test.ts",
    "preview": "vite preview",
    "build:ssg": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs"
  },
  "dependencies": {
    "@griffel/react": "^1.7.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@griffel/vite-plugin": "^1.0.1",
    "@mathjax/src": "^4.1.3",
    "@mdx-js/mdx": "^3.1.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-text": "^4.0.3",
    "oxlint": "^1.89.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "unist-util-visit-parents": "^6.1.0",
    "vite": "^8.3.5"
  }
}
